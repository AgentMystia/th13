# 原版游戏与版权材料——绝不入库
games/
*.rpy
*.7z

# 大体积产物
artifacts/

# 视觉对拍临时裁片/对比图（原版视频帧衍生物，红线 1：永不入库；
# 会话内产物移存 artifacts/tmp-crops/，新裁片应直接生成于 artifacts/ 下）
.tmp-crops/

# thtk 临时克隆与构建（用后清理）
tools/thtk-tmp/

# monorepo 独立克隆（有自己的 git）
eagler-touhou/

# 容器内工具缓存（emscripten/yt-dlp/bgpot 等，均在工作区卷内）
.cache/
.cache-*
!.gitignore

# 本地环境
.env
*.log
__pycache__/

# 容器内工具 XDG 落脏兜底（正常应写入容器 HOME，不进工作区）
.config/
.local/

# r5 起：轮次产物归档与本地会话目录不入库（大体积 JSONL/临时件）
r4/
tmp/
.zcode/
